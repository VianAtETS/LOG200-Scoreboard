{
  "name": "log200-scoreboard-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:golden": "node dev/golden-server.mjs",
    "build": "astro build",
    "astro:sync": "astro sync",
    "typecheck:ts": "bun check --no-script --no-pretty",
    "typecheck:astro": "bun node_modules/@typescript/native/bin/tsc -p tsconfig.astro.json --noEmit --runExternalCode --pretty false",
    "typecheck": "bun run astro:sync && bun run --parallel --no-exit-on-error typecheck:ts typecheck:astro",
    "typecheck:watch": "astro sync && bun node_modules/@typescript/native/bin/tsc -p tsconfig.astro.json --noEmit --runExternalCode --watch",
    "preview": "astro preview",
    "lint:ts": "oxlint . --deny-warnings",
    "lint:astro": "eslint \"src/**/*.astro\"",
    "lint:typed": "oxlint -c .oxlintrc.typed.json . --type-aware --threads=2 --deny-warnings --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint -c .oxlintrc.typed.json . --type-aware --threads=2 --fix",
    "lint:fast": "bun run --parallel --no-exit-on-error lint:ts lint:astro",
    "lint": "bun run --parallel --no-exit-on-error lint:typed lint:astro",
    "test": "bun test ./src --parallel=4 --parallel-delay=0 --no-isolate --concurrent --max-concurrency=60",
    "test:watch": "bun test --watch ./src --parallel=4 --parallel-delay=0 --no-isolate --concurrent --max-concurrency=60",
    "suite:quick": "bun run --parallel --no-exit-on-error lint:ts lint:astro format test",
    "suite": "bun run astro:sync && bun run --parallel --no-exit-on-error lint:typed lint:astro format typecheck:ts typecheck:astro test audit && bun run build",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "audit": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@tanstack/react-query": "^5.108.4",
    "astro": "^7.4.13",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@astrojs/ts-content-mapper": "0.2.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "8.74.0",
    "@typescript/native": "npm:typescript@7.1.0-dev.20261125.1",
    "astro-eslint-parser": "3.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-plugin-react-doctor": "0.9.23",
    "tsrs": "^7.1.0-beta.tsrs5",
    "typescript": "6.0.3"
  }
}
